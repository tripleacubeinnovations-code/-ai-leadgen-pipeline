# ============================================
# AI Lead-Gen Pipeline — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ----- Google Places API -----
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: "Places API (New)" in your GCP project
GOOGLE_PLACES_API_KEY=

# ----- OpenAI API -----
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model to use for site + email generation (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# ----- Vercel -----
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Optional: Vercel team ID (leave blank for personal account)
VERCEL_TEAM_ID=

# ----- Mailgun -----
# Get from: https://app.mailgun.com/settings/api_security
MAILGUN_API_KEY=
# Your verified Mailgun domain (e.g., mg.yourdomain.com)
MAILGUN_DOMAIN=
# Set to "eu" if your Mailgun account is in the EU region
MAILGUN_REGION=us

# ----- Email Settings -----
# Sender "From" address (must be verified with your Mailgun domain)
SENDER_EMAIL=hello@yourdomain.com
# Sender display name
SENDER_NAME=Your Name

# ----- Google Sheets Logging -----
# The spreadsheet ID from your Google Sheet URL
# e.g., https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=
# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# ----- Follow-Up Settings -----
# Days to wait before sending follow-up (default: 3)
FOLLOW_UP_DELAY_DAYS=3
# Cron schedule for auto follow-up checks (default: daily at 9 AM)
FOLLOW_UP_CRON=0 9 * * *

# ----- Pipeline Settings -----
# Max concurrent operations per pipeline step
CONCURRENCY_LIMIT=3
# Set to "true" to skip actual email sending and deployment
DRY_RUN=false
