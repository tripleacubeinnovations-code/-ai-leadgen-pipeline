# ============================================
# 🎁 AI Lead-Gen Pipeline — 100% FREE / NO-CARD Stack
# ============================================
# Copy this file to .env and fill in your free keys:
#   copy .env.example .env

# ----- 1. Gemini AI API (100% FREE - NO CARD REQUIRED) -----
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini model (default: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ----- 2. Email Provider (Choose Resend OR Gmail SMTP) -----
# Option A: Resend API (100% FREE - 3,000 emails/mo, NO CARD)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Option B: Gmail SMTP (Optional fallback - 500 emails/day)
# Turn on 2-step verification & get App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sender Details
SENDER_EMAIL=onboarding@resend.dev
SENDER_NAME=TripleACube Innovations

# ----- 3. Vercel Hosting (100% FREE - NO CARD REQUIRED) -----
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ----- 4. Follow-Up Settings -----
FOLLOW_UP_DELAY_DAYS=3
FOLLOW_UP_CRON=0 9 * * *

# ----- 5. Pipeline Settings -----
CONCURRENCY_LIMIT=3
DRY_RUN=false
