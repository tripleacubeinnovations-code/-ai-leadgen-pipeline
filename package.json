{
  "name": "ai-leadgen-pipeline",
  "version": "1.1.0",
  "description": "100% FREE AI-powered lead generation automation pipeline — discovers businesses without websites using OpenStreetMap, generates demo sites & cold emails using Google Gemini API, deploys to Vercel, and sends emails via Resend or Gmail SMTP.",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "leadgen": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "pipeline": "node src/cli.js run",
    "find-leads": "node src/cli.js find-leads",
    "generate-site": "node src/cli.js generate-site",
    "deploy-sites": "node src/cli.js deploy-sites",
    "send-emails": "node src/cli.js send-emails",
    "follow-up": "node src/cli.js follow-up",
    "check-config": "node src/cli.js check-config"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "googleapis": "^140.0.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "ora": "^8.0.1",
    "resend": "^3.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "lead-generation",
    "cold-email",
    "automation",
    "ai",
    "gemini",
    "free"
  ],
  "license": "UNLICENSED",
  "private": true
}
